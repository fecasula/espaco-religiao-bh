<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="pt-BR">
  <info>
    <title>ABNT autor-data — adaptação local auditável</title>
    <id>https://example.org/styles/abnt-local-auditavel</id>
    <link href="https://www.zotero.org/styles/associacao-brasileira-de-normas-tecnicas" rel="template"/>
    <author><name>Equipe do projeto Religião, Mobilidade e Cobertura Urbana</name></author>
    <category citation-format="author-date"/>
    <updated>2026-07-29T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</rights>
  </info>
  <locale xml:lang="pt-BR">
    <terms>
      <term name="and">e</term>
      <term name="et-al">et al.</term>
      <term name="page" form="short">p.</term>
      <term name="editor" form="short"><single>org.</single><multiple>orgs.</multiple></term>
      <term name="month-01" form="short">jan.</term><term name="month-02" form="short">fev.</term>
      <term name="month-03" form="short">mar.</term><term name="month-04" form="short">abr.</term>
      <term name="month-05" form="short">maio</term><term name="month-06" form="short">jun.</term>
      <term name="month-07" form="short">jul.</term><term name="month-08" form="short">ago.</term>
      <term name="month-09" form="short">set.</term><term name="month-10" form="short">out.</term>
      <term name="month-11" form="short">nov.</term><term name="month-12" form="short">dez.</term>
    </terms>
  </locale>
  <macro name="author-short">
    <names variable="author">
      <name form="short" delimiter="; " and="text" et-al-min="4" et-al-use-first="1"/>
      <substitute><names variable="editor"/><text variable="title" form="short"/></substitute>
    </names>
  </macro>
  <macro name="author-bib">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize="false" delimiter="; " and="text" et-al-min="4" et-al-use-first="1">
        <name-part name="family" text-case="uppercase"/><name-part name="given"/>
      </name>
      <substitute><names variable="editor"/><text variable="title" text-case="uppercase"/></substitute>
    </names>
  </macro>
  <macro name="issued-year"><date variable="issued"><date-part name="year"/></date></macro>
  <macro name="access">
    <group delimiter=". "><text variable="URL" prefix="Disponível em: "/><date variable="accessed" prefix="Acesso em: "><date-part name="day" suffix=" "/><date-part name="month" form="short" suffix=" "/><date-part name="year"/></date></group>
  </macro>
  <citation et-al-min="4" et-al-use-first="1" collapse="year" disambiguate-add-year-suffix="true">
    <layout prefix="(" suffix=")" delimiter="; "><group delimiter=", "><text macro="author-short"/><text macro="issued-year"/><group delimiter=" "><label variable="locator" form="short"/><text variable="locator"/></group></group></layout>
  </citation>
  <bibliography entry-spacing="1" hanging-indent="false">
    <sort><key macro="author-bib"/><key variable="issued"/></sort>
    <layout suffix=".">
      <text macro="author-bib" suffix=". "/>
      <text variable="title" suffix=". "/>
      <choose>
        <if type="article-journal">
          <text variable="container-title" font-weight="bold" suffix=", "/><text variable="volume" prefix="v. " suffix=", "/><text variable="issue" prefix="n. " suffix=", "/><text variable="page" prefix="p. " suffix=", "/><text macro="issued-year"/>
        </if>
        <else-if type="paper-conference">
          <text value="In: " font-style="italic"/><text variable="event" text-case="uppercase" suffix=". "/><text variable="container-title" font-weight="bold" suffix=". "/><text variable="publisher-place" suffix=": "/><text variable="publisher" suffix=", "/><text macro="issued-year"/>
        </else-if>
        <else>
          <text variable="publisher-place" suffix=": "/><text variable="publisher" suffix=", "/><text macro="issued-year"/>
        </else>
      </choose>
      <text macro="access" prefix=". "/>
      <text variable="DOI" prefix=". DOI: "/>
    </layout>
  </bibliography>
</style>
